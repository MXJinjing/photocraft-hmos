{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_description",
    "mainElement": "EntryAbility",
    "deviceTypes": ["tablet", "2in1"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.PRINT"
      },
      { "name": "ohos.permission.INTERNET" },
      {
        "name": "ohos.permission.ACCESS_BLUETOOTH",
        "reason": "$string:stylus_bluetooth_reason",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:module_description",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "launchType": "singleton",
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["ohos.want.action.home"]
          },
          {
            "actions": ["ohos.want.action.viewData"],
            "uris": [
              {"scheme": "file", "type": "general.jpeg", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "general.png", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "general.tiff", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "general.gif", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "general.raw-image", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "general.pbm-image", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "general.pgm-image", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "general.ppm-image", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "com.microsoft.bmp", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "com.microsoft.ico", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "com.truevision.tga-image", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "com.ilm.openexr-image", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "com.adobe.photoshop-image", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "io.github.mxjinjing.photocraft.pcraft", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "io.github.mxjinjing.photocraft.webp", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "io.github.mxjinjing.photocraft.heif", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "io.github.mxjinjing.photocraft.psb", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "io.github.mxjinjing.photocraft.qoi", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "io.github.mxjinjing.photocraft.hdr", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "io.github.mxjinjing.photocraft.portable-image", "linkFeature": "FileOpen"},
              {"scheme": "file", "type": "io.github.mxjinjing.photocraft.camera-raw", "linkFeature": "FileOpen"}
            ]
          }
        ]
      }
    ]
  }
}
