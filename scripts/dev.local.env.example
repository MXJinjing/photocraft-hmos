# Optional machine-specific paths. Copy to the ignored dev.local.env.
# CARGO_HOME=/absolute/path/to/cargo
# RUSTUP_HOME=/absolute/path/to/rustup
# PATH="$CARGO_HOME/bin:$PATH"
# PHOTOCRAFT_NATIVE_SDK=/absolute/path/to/openharmony/native
# PHOTOCRAFT_HDC=/absolute/path/to/hdc
# PHOTOCRAFT_HVIGOR=/absolute/path/to/hvigorw
# PHOTOCRAFT_OHPM=/absolute/path/to/ohpm
# PHOTOCRAFT_BUNDLE=io.github.mxjinjing.hmos
# For a private bundle, use a separate local worktree and change AppScope/app.json5,
# entry/src/main/module.json5, and entry/src/main/resources/rawfile/arkdata/utd/utd.json5
# there. Match the bundle in the ignored build-profile.json5 signing configuration.
